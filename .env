# Local development only. Change these values for your machine if required.
POSTGRES_DB=payment_platform
POSTGRES_USER=payment_app
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_PORT=5432

REDIS_PORT=6379

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Kafka broker advertised to the local Spring Boot application
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
