{
  "info": {
    "_postman_id": "a7b43a61-2f9d-4a6b-8f12-7e9b3d5c1a20",
    "name": "Enterprise Payment Platform - Phase 1 API Tests",
    "description": "Postman collection for Phase 1 customer and account APIs. Run requests in order using Collection Runner. The collection creates a customer, creates an account for that customer, then retrieves both resources and the account balance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Customer API",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Tan\",\n  \"email\": \"{{testEmail}}\",\n  \"phoneNumber\": \"+60123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = `alex.tan.${Date.now()}@example.test`;",
                  "pm.collectionVariables.set('testEmail', uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains customerId', () => pm.expect(body.customerId).to.be.a('string').and.not.empty);",
                  "pm.test('Customer fields are returned', () => {",
                  "  pm.expect(body.firstName).to.eql('Alex');",
                  "  pm.expect(body.lastName).to.eql('Tan');",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "  pm.expect(body.status).to.eql('ACTIVE');",
                  "});",
                  "pm.collectionVariables.set('customerId', body.customerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returned customer matches created customer', () => {",
                  "  pm.expect(body.customerId).to.eql(pm.collectionVariables.get('customerId'));",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create customer - duplicate email (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Tan\",\n  \"email\": \"{{testEmail}}\",\n  \"phoneNumber\": \"+60123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409 Conflict for duplicate email', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create customer - invalid email (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Invalid\",\n  \"lastName\": \"Email\",\n  \"email\": \"not-an-email\",\n  \"phoneNumber\": \"+60123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400 Bad Request for invalid email', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer - unknown UUID (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/00000000-0000-0000-0000-000000000001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "00000000-0000-0000-0000-000000000001"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404 Not Found for unknown customer', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Account API",
      "item": [
        {
          "name": "Create savings account (MYR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"MYR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Account response has expected fields', () => {",
                  "  pm.expect(body.accountId).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.customerId).to.eql(pm.collectionVariables.get('customerId'));",
                  "  pm.expect(body.accountType).to.eql('SAVINGS');",
                  "  pm.expect(body.currency).to.eql('MYR');",
                  "  pm.expect(body.status).to.eql('ACTIVE');",
                  "  pm.expect(Number(body.balance)).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set('accountId', body.accountId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "{{accountId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Account belongs to created customer', () => {",
                  "  pm.expect(body.accountId).to.eql(pm.collectionVariables.get('accountId'));",
                  "  pm.expect(body.customerId).to.eql(pm.collectionVariables.get('customerId'));",
                  "  pm.expect(body.currency).to.eql('MYR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "{{accountId}}",
                "balance"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Initial balance is zero MYR', () => {",
                  "  pm.expect(body.accountId).to.eql(pm.collectionVariables.get('accountId'));",
                  "  pm.expect(Number(body.balance)).to.eql(0);",
                  "  pm.expect(body.currency).to.eql('MYR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create account - invalid currency (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"MY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400 Bad Request for invalid currency', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account - unknown UUID (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/00000000-0000-0000-0000-000000000002",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "00000000-0000-0000-0000-000000000002"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404 Not Found for unknown account', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}