global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: payment-api
    metrics_path: /actuator/prometheus
    scrape_interval: 10s
    static_configs:
      - targets:
          - __PROMETHEUS_TARGET__
    basic_auth:
      username: __METRICS_USERNAME__
      password_file: /etc/prometheus/secrets/metrics-password
