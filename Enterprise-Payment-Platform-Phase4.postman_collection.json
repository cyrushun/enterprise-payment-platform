            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Privileged role authentication",
      "description": "Use the local V6 seeded test users. Login separately for OPERATIONS and ADMIN; each request stores its access token in a role-specific collection variable.",
      "item": [
        {
          "name": "Login as OPERATIONS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{operationsEmail}}\",\n  \"password\": \"{{operationsPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate the seeded OPERATIONS user. The access token is saved to {{operationsToken}}; do not copy it into the CUSTOMER accessToken variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test('Access and refresh tokens returned',()=>{pm.expect(b.accessToken).to.be.a('string').and.not.empty;pm.expect(b.refreshToken).to.be.a('string').and.not.empty;});",
                  "pm.collectionVariables.set('operationsToken',b.accessToken);",
                  "pm.collectionVariables.set('operationsRefreshToken',b.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate the seeded ADMIN user. The access token is saved to {{adminToken}}; do not copy it into the CUSTOMER accessToken variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test('Access and refresh tokens returned',()=>{pm.expect(b.accessToken).to.be.a('string').and.not.empty;pm.expect(b.refreshToken).to.be.a('string').and.not.empty;});",
                  "pm.collectionVariables.set('adminToken',b.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken',b.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Role authorization (privileged token optional)",
      "item": [
        {
          "name": "09 - CUSTOMER denied outbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/outbox/events?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "outbox",
                "events"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Uses the customer token from registration/login.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CUSTOMER gets 403',()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "10A - OPERATIONS list outbox",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/outbox/events?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "outbox",
                "events"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Replace accessToken with an appropriately provisioned privileged token before running.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operationsToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Privileged role gets 200',()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();pm.expect(b.content).to.be.an('array');",
                  "if(b.content.length)pm.collectionVariables.set('outboxEventId',b.content[0].id);",
                  "const dead=b.content.find(e=>e.status==='DEAD'); const nonDead=b.content.find(e=>e.status!=='DEAD'); if(dead)pm.collectionVariables.set('deadOutboxEventId',dead.id); if(nonDead)pm.collectionVariables.set('nonDeadOutboxEventId',nonDead.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "10B - ADMIN list outbox",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/outbox/events?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "outbox",
                "events"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Run ADMIN login first. Confirms that ADMIN can independently access the privileged outbox listing.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN gets 200',()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();pm.expect(b.content).to.be.an('array');",
                  "if(b.content.length)pm.collectionVariables.set('outboxEventId',b.content[0].id);",
                  "const dead=b.content.find(e=>e.status==='DEAD'); const nonDead=b.content.find(e=>e.status!=='DEAD'); if(dead)pm.collectionVariables.set('deadOutboxEventId',dead.id); if(nonDead)pm.collectionVariables.set('nonDeadOutboxEventId',nonDead.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Get outbox event",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/outbox/events/{{outboxEventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "outbox",
                "events",
