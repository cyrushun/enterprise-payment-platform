        {
          "name": "15 - Replay dead outbox event (OPERATIONS/ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operationsToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/outbox/events/{{deadOutboxEventId}}/replay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "outbox",
                "events",
                "{{deadOutboxEventId}}",
                "replay"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Replay succeeds or reports a documented state/resource error\",()=>pm.expect(pm.response.code).to.be.oneOf([200,404,409]));",
                  "if(pm.response.code>=400){const b=pm.response.json();pm.test(\"ApiError contract\",()=>{pm.expect(b.code).to.be.a(\"string\");pm.expect(b.message).to.be.a(\"string\");pm.expect(b.timestamp).to.exist;pm.expect(b.details).to.be.an(\"array\");});}"
                ]
              }
            }
          ]
        },
        {
          "name": "16 - Replay Kafka DLT payload (OPERATIONS/ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operationsToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventKey\": \"{{dltEventKey}}\",\n  \"payload\": \"{{dltPayload}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/operations/kafka-dlt/replay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "operations",
                "kafka-dlt",
                "replay"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Kafka replay succeeds\",()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test(\"Broker acknowledgement metadata exists\",()=>{pm.expect(b.accepted).to.eql(true);pm.expect(b.topic).to.be.a(\"string\");pm.expect(b.partition).to.be.a(\"number\");pm.expect(b.offset).to.be.a(\"number\");});"
                ]
              }
            }
          ]
