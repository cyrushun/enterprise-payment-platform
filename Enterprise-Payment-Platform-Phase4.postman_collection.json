    {
      "name": "Redis rate limiting",
      "description": "Redis-backed API rate-limit scenarios. Run the login probe six times from the same client IP within one minute; run the general API probe repeatedly using the CUSTOMER access token.",
      "item": [
        {
          "name": "16 - Login rate-limit probe (repeat 6 times)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Send six times from the same client IP within one minute. First five should reach login (401 with invalid password); sixth should return 429.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"intentionally-wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===429){pm.test('429 rate limit',()=>{pm.expect(pm.response.json().code).to.eql('RATE_LIMIT_EXCEEDED');pm.expect(pm.response.headers.has('Retry-After')).to.eql(true);});}else{pm.test('Within login limit',()=>pm.expect(pm.response.code).to.eql(401));}",
                  "pm.test('Rate limit headers',()=>{pm.expect(pm.response.headers.has('X-RateLimit-Limit')).to.eql(true);pm.expect(pm.response.headers.has('X-RateLimit-Remaining')).to.eql(true);});"
                ]
              }
            }
          ]
        },
        {
          "name": "17 - General API rate-limit probe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Repeat more than the configured general API limit (default 100/minute) using the same authenticated customer.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected success or rate-limit response',()=>pm.expect(pm.response.code).to.be.oneOf([200,429]));",
                  "if(pm.response.code===429)pm.test('429 error contract',()=>pm.expect(pm.response.json().code).to.eql('RATE_LIMIT_EXCEEDED'));",
                  "pm.test('Rate limit header present',()=>pm.expect(pm.response.headers.has('X-RateLimit-Limit')).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
