{
  "info": {
    "name": "Enterprise Payment Platform - Phase 4 API Tests",
    "description": "Phase 4 API acceptance collection. Run sequentially. Authentication flows use CUSTOMER token; privileged requests require operationsToken. Negative cases assert stable ApiError codes. Dependency-outage scenarios are documented in docs/verification/phase-4-complete-testing-guide.md and must be executed only in a disposable local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "phase4.customer@example.test"
    },
    {
      "key": "password",
      "value": "LocalOnly-Passw0rd!"
    },
    {
      "key": "firstName",
      "value": "Alex"
    },
    {
      "key": "lastName",
      "value": "Tan"
    },
    {
      "key": "phoneNumber",
      "value": "+60123456789"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "previousRefreshToken",
      "value": ""
    },
    {
      "key": "outboxEventId",
      "value": ""
    },
    {
      "key": "operationsToken",
      "value": ""
    },
    {
      "key": "dltEventKey",
      "value": ""
