                  "key": "token",
                  "value": "{{operationsToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.expect(['PENDING','PROCESSING','RETRY','PUBLISHED','DEAD']).to.include(pm.response.json().status);"
                ]
              }
            }
          ]
        },
